# Todo es opcional: sin estas variables la app funciona y guarda el progreso en el navegador.
# openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps. Callback: <dominio>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth. Callback: <dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Postgres (Neon en producción). La tabla profiles se crea sola.
DATABASE_URL=
# Aviso de racha por correo (opcional). Resend: crear la API key y verificar el dominio del remitente.
RESEND_API_KEY=
# Ej.: Procode <avisos@tudominio.com>
MAIL_FROM=
# Vercel Cron lo manda en el header Authorization al llamar /api/cron/streak. openssl rand -base64 32
CRON_SECRET=
# Correo que recibe el formulario de contacto (no se muestra en la página). Usa RESEND_API_KEY y MAIL_FROM.
CONTACT_TO=

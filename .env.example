# Todo es opcional: sin estas variables la app funciona y guarda el progreso en el navegador.
# openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps. Callback: <dominio>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth. Callback: <dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Discord Developer Portal → Applications → OAuth2. Callback: <dominio>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# GitLab → Preferences → Applications (scope read_user). Callback: <dominio>/api/auth/callback/gitlab
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
# Postgres (Neon en producción). Las tablas profiles y users se crean solas; con esto aparece el login con email y contraseña.
DATABASE_URL=
# Aviso de racha por correo (opcional). Resend: crear la API key y verificar el dominio del remitente.
RESEND_API_KEY=
# Ej.: Procode <avisos@tudominio.com>
MAIL_FROM=
# Vercel Cron lo manda en el header Authorization al llamar /api/cron/streak. openssl rand -base64 32
CRON_SECRET=
# Dominio para los links del aviso de racha (opcional; si falta usa el de la llamada al cron). Ej.: https://procode.vercel.app
SITE_URL=
# Correo que recibe el formulario de contacto (no se muestra en la página). Usa RESEND_API_KEY y MAIL_FROM.
CONTACT_TO=
